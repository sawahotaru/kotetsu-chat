# チャット単体の設定。使うときは `cp .env.example .env` して要る行だけ外す。
# 何も書かなくても動く（すべて既定値がある）。
#
# ⚠ 真偽の項目は 1/0 のほか true/false・yes/no・on/off も使える。
#   前段(Go)と後段(Python)で解釈は同じ。読めない値を書くと**起動時に止まる**
#   （既定値で黙って動き続けない）。

# ---- 持ち出したフォルダで動かすとき ----
# compose がビルドの元（apps/chat-*）を探す根。既定はこの repo（../..）。
# bundle.sh が作ったフォルダでは、隣に apps/ があるので `.` になる。
# ⚠ bundle.sh は .env にこの2行を書き込む。消さないこと。
# CHAT_SRC=.
# CHAT_CONTENT_HOST_DIR=./content-minimal

# ---- 待ち受け ----
# ⚠ 127.0.0.1 のまま使うこと。0.0.0.0 にすると LAN の誰でも触れる。
#   外へ出すときは前に TLS を張った逆代理を置く（README「公開するときの注意」）。
# CHAT_BIND=127.0.0.1
# CHAT_PORT=8080

# ---- 中身の差し替え ----
# 自分の人格・回答にするなら2行そろえて外す。書き方は apps/chat-ai/content/README.md。
# CHAT_CONTENT_HOST_DIR=./my-content
# CHAT_CONTENT_DIR=/content

# ---- 設置ごとの追加処理（連携）----
# 自分の在庫・予約システムに繋ぐ Python モジュールを足すときだけ。
# 見本は examples/site-handler/my_shop.py、読み込みの作法は apps/chat-ai/plugins.py。
# 空のあいだ、それを参照する意図は起動時に自動で外れる。
# CHAT_SITE_HANDLERS=

# ---- 地域・情報源（既定は日本向け）----
# 外部（気象庁・Open-Meteo・Wikipedia）を叩くときの名乗り。
# ⚠ 公開するなら必ず自分のものに書き換える。
# CHAT_USER_AGENT=my-site chat (+https://example.com/)
# 天気の情報源。open-meteo にすると気象庁を使わず、
# content/places.yaml に書いた地名だけを引く（日本の外へ配るとき）。
# WEATHER_SOURCE=auto
# 調べ物の言語版
# WIKIPEDIA_LANG=ja

# ---- 守り（公開するなら必ず読むこと）----
# IP ごとのレート制限。⚠ 外に出すなら緩めないこと。
# CHAT_RATE_PER_MIN=12
# CHAT_RATE_BURST=5
# 1通の長さと、送る履歴の往復数の上限
# CHAT_MAX_MESSAGE_CHARS=2000
# CHAT_MAX_HISTORY=8
# 同時に生成する本数。⚠ CPU 推論では 1 から上げない
# CHAT_MAX_CONCURRENT=1
# 順番待ちの上限と、1回の生成の打ち切り（前者は後者より短くすること）
# CHAT_QUEUE_WAIT_SECONDS=30
# CHAT_GEN_TIMEOUT_SECONDS=180

# ---- LLM（既定は無効。README の注意を読んでから有効にすること）----
# 両方を 1 にし、`docker compose --profile llm up -d` で ollama ごと起動する。
# CHAT_LLM_ENABLED=1   # 後段: LLM を使える状態にする
# CHAT_ALLOW_LLM=1     # 前段: この口から LLM を使わせる
#
# 使ってよいモデル（許可リスト）。先頭が既定。起動時にこの順で自動 pull する。
# ⚠ GPU 無しなら 1〜3B 級に限る。7B 以上は CPU では実用にならない。
# ⚠ ディスクの空きを確認してから増やす（1モデル 0.8〜2GB）。
# CHAT_MODELS=gemma3:1b,qwen2.5:1.5b
# CHAT_NUM_PREDICT=512
# ollama に渡す CPU・メモリの上限（1コアは他へ残す）
# OLLAMA_CPUS=3.0
# OLLAMA_MEM_LIMIT=4g
# 生成後にモデルをメモリへ載せておく時間（短いほど常駐RAMが減る）
# OLLAMA_KEEP_ALIVE=5m
